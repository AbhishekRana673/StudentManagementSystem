<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" id="WebApp_ID" version="6.0">
  <display-name>StudentManagement</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
  
  <servlet>
  	<servlet-name>StudentLogin</servlet-name>
  	<servlet-class>com.abhi.student.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>StudentLogin</servlet-name>
  	<url-pattern>/login</url-pattern>
  </servlet-mapping>
  
  <servlet>
  	<servlet-name>StudentRegister</servlet-name>
  	<servlet-class>com.abhi.student.RegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>StudentRegister</servlet-name>
  	<url-pattern>/register</url-pattern>
  </servlet-mapping>
  
</web-app>